// =============================================================================
// Jenkins - Recycle de Application Pool por cliente (IIS)
// Playbook: recycle-pool-cliente.yml
//
// Fluxo:  ACAO=PLANO -> so mostra o que seria feito  |  ACAO=EXECUTAR -> recicla direto
//         (o proprio Jenkins registra quem disparou cada build)
//
// Credencial: Jenkins "iis-deploy-winrm" (Username with password).
//   Substitui o ansible-vault: o inventory/group_vars/all/vault.yml NAO e usado aqui.
//
// Requisitos do agente: ansible-core, python3-winrm e as colecoes do requirements.yml.
// =============================================================================

pipeline {
    agent any  // ajuste para o label do seu agente Linux com ansible

    options {
        disableConcurrentBuilds()            // nunca dois recycles ao mesmo tempo
        timeout(time: 30, unit: 'MINUTES')
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    parameters {
        string(name: 'CLIENTE', defaultValue: '', trim: true,
               description: 'Nome do cliente (parte do nome do site). Ex.: biolab')
        choice(name: 'SERVIDOR',
               choices: ['webhomolog', 'web03', 'web01', 'web02', 'web04', 'PRODUCAO (web01-04)', 'TODOS'],
               description: 'Onde rodar. Onde vai buscar o site do cliente. "TODOS" = todos os servidores IIS (homolog + web01-04).')
        choice(name: 'ACAO', choices: ['PLANO', 'EXECUTAR'],
               description: 'PLANO = so mostra o que seria feito. EXECUTAR = recicla direto, sem aprovacao.')
        booleanParam(name: 'BUSCA_EXATA', defaultValue: false,
                     description: 'Nome exato do site/aplicacao, em vez de "contem".')
    }

    environment {
        ANSIBLE_CONFIG       = "${WORKSPACE}/ansible.cfg"
        ANSIBLE_FORCE_COLOR  = 'false'
        ANSIBLE_STDOUT_CALLBACK = 'default'
        INV_DIR              = "${WORKSPACE}/.jenkins-inventory"
        CREDENCIAL_WINRM     = 'iis-deploy-winrm'
    }

    stages {
        stage('Validar parametros') {
            steps {
                script {
                    if (!(params.CLIENTE ==~ /^[A-Za-z0-9._-]{3,}$/)) {
                        error("CLIENTE invalido: minimo 3 caracteres, apenas letras, numeros, ponto, hifen e underline.")
                    }
                    def limites = [
                        'PRODUCAO (web01-04)': 'iis:!homolog',
                        'TODOS'              : 'iis',
                    ]
                    env.LIMITE = limites.get(params.SERVIDOR, params.SERVIDOR)

                    currentBuild.displayName = "#${BUILD_NUMBER} ${params.CLIENTE} @ ${params.SERVIDOR} (${params.ACAO})"
                }
            }
        }

        stage('Preparar inventario') {
            steps {
                // Copia o inventario SEM o vault.yml: a credencial vem do Jenkins.
                sh '''
                    rm -rf "$INV_DIR"
                    cp -r inventory "$INV_DIR"
                    rm -f "$INV_DIR/group_vars/all/vault.yml"
                    mkdir -p "$WORKSPACE/logs"
                    ansible-galaxy collection install -r requirements.yml >/dev/null
                '''
            }
        }

        stage('Plano') {
            when { expression { params.ACAO == 'PLANO' } }
            steps {
                script { rodarPlaybook(false) }
            }
        }

        stage('Recycle') {
            when { expression { params.ACAO == 'EXECUTAR' } }
            steps {
                script { rodarPlaybook(true) }
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: 'logs/iis-recycle-pool.log', allowEmptyArchive: true
            sh 'rm -rf "$INV_DIR"'
        }
    }
}

// Roda o playbook com a credencial do Jenkins.
// A senha NAO aparece na linha de comando: o ansible le das variaveis de ambiente.
def rodarPlaybook(boolean executar) {
    withCredentials([usernamePassword(credentialsId: env.CREDENCIAL_WINRM,
                                      usernameVariable: 'WINRM_USER',
                                      passwordVariable: 'WINRM_PASS')]) {
        withEnv(["CONFIRMAR=${executar ? 'SIM' : 'NAO'}",
                 "BUSCA_EXATA=${params.BUSCA_EXATA}",
                 "CLIENTE=${params.CLIENTE}"]) {
            sh '''
                ansible-playbook recycle-pool-cliente.yml \
                  -i "$INV_DIR/hosts.ini" \
                  --limit "$LIMITE" \
                  -e "cliente=$CLIENTE" \
                  -e "confirmar=$CONFIRMAR" \
                  -e "busca_exata=$BUSCA_EXATA" \
\
                  -e "{\\"log_recycle\\": \\"$WORKSPACE/logs/iis-recycle-pool.log\\"}" \
                  -e "vault_winrm_user={{ lookup('env', 'WINRM_USER') }}" \
                  -e "vault_winrm_password={{ lookup('env', 'WINRM_PASS') }}"
            '''
        }
    }
}
